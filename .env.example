# Backend (local)
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional local Postgres)
# POSTGRES_DB=breathe_esg
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Render provides DATABASE_URL automatically in production

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# Multi-tenant strict mode (optional)
REQUIRE_TENANT_ID=false
ENFORCE_TENANT_MEMBERSHIP=false

# Production cross-origin frontend (set on API service when frontend is separate)
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-frontend.onrender.com
# CROSS_SITE_COOKIES=true

# First deploy only
# RUN_SEED=true
